# ---------------------------------------------------------------------------
# Animateur de Photos Produit — configuration
# Copiez ce fichier en « .env » puis renseignez au moins une clé.
# ---------------------------------------------------------------------------

# === Clés des moteurs de génération =======================================
# Une seule clé suffit : le premier moteur configuré est utilisé.
# Vous pouvez aussi les saisir depuis l'interface (bouton « Réglages »),
# qui les écrit ici automatiquement.

# 1. Veo 3.1 (Google) — le meilleur rendu : audio natif et texte bien intégré.
#    ATTENTION : nécessite un projet Google avec FACTURATION ACTIVÉE (palier
#    Tier 1). Sur le palier gratuit, Veo renvoie une erreur 429.
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. fal.ai — modèles ouverts (Wan, LTX) ou propriétaires (Kling, Hailuo),
#    facturés à la seconde et bien moins chers que Veo.
#    Des crédits sont offerts à l'inscription. https://fal.ai/dashboard/keys
FAL_KEY=
# Modèle fal utilisé, et durée d'un clip produite par ce modèle.
# Vérifiez ces deux valeurs sur la page du modèle choisi : elles varient.
FAL_MODEL=fal-ai/wan-i2v
FAL_CLIP_SECONDS=5

# 3. Replicate — très large catalogue, facturé à la seconde.
#    https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# « owner/nom » pour un modèle public, ou « owner/nom:hash » pour une version figée.
REPLICATE_MODEL=wan-video/wan-2.2-i2v-fast
REPLICATE_CLIP_SECONDS=5

# Force un moteur précis, même si plusieurs clés sont présentes.
# Valeurs : veo | fal | replicate
# PROVIDER=veo

# === Serveur ==============================================================
# L'interface n'est volontairement accessible que depuis la machine locale.
PORT=5178
HOST=127.0.0.1

# Force le rendu local de démonstration (aucun appel distant, aucun coût).
# DEMO=1

# Binaire ffmpeg spécifique (facultatif : un ffmpeg est fourni par le paquet
# @ffmpeg-installer/ffmpeg, sinon la variable PATH est utilisée).
# FFMPEG_PATH=C:\chemin\vers\ffmpeg.exe
