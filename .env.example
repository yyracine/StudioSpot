# ---------------------------------------------------------------------------
# Animateur de Photos Produit — configuration
# Copiez ce fichier en « .env » puis renseignez votre clé.
# ---------------------------------------------------------------------------

# Clé API Google AI Studio, indispensable pour la génération Veo.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port et interface d'écoute du serveur.
# L'interface n'est volontairement accessible que depuis la machine locale.
PORT=5178
HOST=127.0.0.1

# Force le mode démo local (aucun appel Veo, aucun coût).
# DEMO=1

# Chemin vers un binaire ffmpeg spécifique (facultatif : un ffmpeg est fourni
# par le paquet @ffmpeg-installer/ffmpeg, sinon la variable PATH est utilisée).
# FFMPEG_PATH=C:\chemin\vers\ffmpeg.exe
